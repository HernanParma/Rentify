{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DefaultConnection": "Server=localhost;Database=Autenticacion;Trusted_Connection=True;TrustServerCertificate=true;",

  "SaltSettings": {
    "SaltSize": 32,
    "HashSize": 64
  },

  "Argon2Settings": {
    "DegreeOfParallelism": 8,
    "MemorySize": 8192,
    "Iterations": 40
  },

  "JwtSettings": {
    "key": "RentifySecretKey2024Minimo32Caracteres!",
    "TokenExpirationMinutes": 18000
  },
  "ConnectionString": "Server=localhost;Database=Autenticacion;Trusted_Connection=True;TrustServerCertificate=True;",

  "RefreshTokenSettings": {
    "Length": 64,
    "LifeTimeInMinutes": 240,
    "IdleTimeoutMinutes": 30 //tras X min sin usar el refresh token, expira
  },

  "LockoutSettings": {
    "MaxFailedAccessAttempts": 5,
    "LockoutDurationMinutes": 15
  }

}
