{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/Auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/User/{**catch-all}" }
      },
      "customers-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/Customer/{**catch-all}" }
      },
      "branches-route": {
        "ClusterId": "branch-cluster",
        "Match": { "Path": "/api/v1/BranchOffices/{**catch-all}" }
      },
      "vehicles-route": {
        "ClusterId": "vehicle-cluster",
        "Match": { "Path": "/api/v1/Vehicles/{**catch-all}" }
      },
      "reservations-route": {
        "ClusterId": "reservation-cluster",
        "Match": { "Path": "/api/v1/Reservations/{**catch-all}" }
      },
      "reservation-payment-route": {
        "ClusterId": "reservation-cluster",
        "Match": { "Path": "/api/reservations/{**catch-all}" }
      },
      "payments-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/Payment/{**catch-all}" }
      },
      "admin-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/Admin/{**catch-all}" }
      },
      "notifications-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/v1/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "http://localhost:5093/" }
        }
      },
      "branch-cluster": {
        "Destinations": {
          "branch": { "Address": "http://localhost:5053/" }
        }
      },
      "vehicle-cluster": {
        "Destinations": {
          "vehicle": { "Address": "http://localhost:5054/" }
        }
      },
      "reservation-cluster": {
        "Destinations": {
          "reservation": { "Address": "http://localhost:5055/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": { "Address": "http://localhost:5099/" }
        }
      }
    }
  }
}
